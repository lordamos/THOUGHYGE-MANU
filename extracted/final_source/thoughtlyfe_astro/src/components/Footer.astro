      </div>
      
      <div class="crystal-footer-column">
        <h4 class="crystal-footer-heading">Quick Links</h4>
        <ul class="crystal-footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/shop">Shop</a></li>
          <li><a href="/readings">Sacred Geometry Readings</a></li>
          <li><a href="/education">Education</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/about">About Darwin</a></li>
        </ul>
      </div>
      
      <div class="crystal-footer-column">
        <h4 class="crystal-footer-heading">Products</h4>
        <ul class="crystal-footer-links">
          <li><a href="/shop/book">Thoughtlyfe Book</a></li>
          <li><a href="/shop/courses">Online Courses</a></li>
          <li><a href="/shop/digital">Digital Downloads</a></li>
          <li><a href="/shop/merchandise">Merchandise</a></li>
          <li><a href="/readings">Personal Readings</a></li>
        </ul>
      </div>
      
      <div class="crystal-footer-column">
        <h4 class="crystal-footer-heading">Newsletter</h4>
        <p class="crystal-footer-description">
          Subscribe to receive updates, exclusive content, and special offers.
        </p>
        <form class="crystal-newsletter-form" action="#" method="post">
          <input 
            type="email" 
            class="crystal-newsletter-input" 
            placeholder="Enter your email"
            required
          />
          <button type="submit" class="crystal-btn-primary">Subscribe</button>
        </form>
      </div>
    </div>
    
    <div class="crystal-footer-bottom">
      <div class="crystal-copyright">
        © 2024 Thoughtlyfe. All rights reserved.
      </div>
      <div class="crystal-footer-legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Newsletter form submission
  document.querySelector('.crystal-newsletter-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (e.target as HTMLFormElement).querySelector('input[type="email"]') as HTMLInputElement;
    if (email?.value) {
      // Here you would integrate with your newsletter service
      alert('Thank you for subscribing! We\'ll be in touch soon.');
      email.value = '';
    }
  });
</script>

