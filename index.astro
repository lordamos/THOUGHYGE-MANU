---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoHero from '../components/VideoHero.astro';
---

<Layout title="Thoughtlyfe - Sacred Geometry Within">
  <Header />
  
  <main>
    <!-- Video Hero Section -->
    <VideoHero />
    
    <!-- Book Feature Section -->
    <section class="crystal-section crystal-book-feature">
      <div class="crystal-container">
        <div class="crystal-grid">
          <div class="crystal-grid-col">
            <img 
              src="/images/book-cover.jpg" 
              alt="Thoughtlyfe: Sacred Geometry Within Book Cover" 
              class="crystal-book-image"
            />
          </div>
          <div class="crystal-grid-col">
            <h2 class="crystal-section-title crystal-gradient-text">
              Discover Sacred Geometry Within
            </h2>
            <p class="crystal-text">
              Embark on a transformative journey through the ancient wisdom of sacred geometry. 
              "Thoughtlyfe: Sacred Geometry Within" reveals how geometric patterns and principles 
              can guide you toward inner peace and self-mastery.
            </p>
            
            <div class="crystal-features">
              <div class="crystal-feature">
                <div class="crystal-feature-icon">
                  <svg class="crystal-icon" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                </div>
                <div>
                  <div class="crystal-feature-title">Ancient Wisdom</div>
                  <div class="crystal-feature-text">
                    Explore timeless geometric principles that have guided spiritual seekers for millennia.
                  </div>
                </div>
              </div>
              
              <div class="crystal-feature">
                <div class="crystal-feature-icon">
                  <svg class="crystal-icon" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M9 11H7v9a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3V5a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v6zm0-6h3v2H9V5z"/>
                  </svg>
                </div>
                <div>
                  <div class="crystal-feature-title">Practical Applications</div>
                  <div class="crystal-feature-text">
                    Learn how to apply sacred geometry principles in your daily life for greater harmony.
                  </div>
                </div>
              </div>
              
              <div class="crystal-feature">
                <div class="crystal-feature-icon">
                  <svg class="crystal-icon" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                </div>
                <div>
                  <div class="crystal-feature-title">Inner Peace</div>
                  <div class="crystal-feature-text">
                    Discover pathways to tranquility and self-mastery through geometric meditation.
                  </div>
                </div>
              </div>
            </div>
            
            <div class="crystal-center-button">
              <a href="/shop/book" class="crystal-btn-primary">Get Your Copy</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Author Section -->
    <section class="crystal-section crystal-author">
      <div class="crystal-container">
        <div class="crystal-grid crystal-grid-reverse">
          <div class="crystal-grid-col">
            <img 
              src="/images/author.jpg" 
              alt="Darwin - Author of Thoughtlyfe" 
              class="crystal-author-image"
            />
          </div>
          <div class="crystal-grid-col">
            <h2 class="crystal-section-title crystal-gradient-text">
              Meet Darwin
            </h2>
            <p class="crystal-text">
              Darwin is a dedicated practitioner and teacher of sacred geometry, with over a decade 
              of experience in spiritual guidance and geometric meditation. His unique approach 
              combines ancient wisdom with modern understanding, making sacred geometry accessible 
              to seekers at all levels.
            </p>
            <p class="crystal-text">
              Through personal readings, courses, and his book "Thoughtlyfe," Darwin has helped 
              thousands of individuals discover their inner peace and unlock their potential for 
              self-mastery through the power of sacred geometric principles.
            </p>
            
            <div class="crystal-center-button">
              <a href="/about" class="crystal-btn-light">Learn More About Darwin</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Aura Sync Preview Section -->
    <section class="crystal-section crystal-readings">
      <div class="crystal-container">
        <h2 class="crystal-section-title crystal-light-title">
          Aura Sync Readings
        </h2>
        <p class="crystal-text" style="text-align: center; color: var(--crystal-text-light); max-width: 800px; margin: 0 auto 3rem;">
          Discover how sacred geometry patterns can guide your personal journey toward 
          inner peace and self-mastery through personalized Aura Sync readings with Darwin.
        </p>
        
        <div class="crystal-grid">
          <div class="crystal-grid-col">
            <div style="text-align: center;">
              <h3 style="color: var(--crystal-accent); margin-bottom: 1rem;">Essential Reading</h3>
              <p style="color: var(--crystal-text-light); margin-bottom: 1.5rem;">
                60-minute personal consultation with sacred geometry expert
              </p>
              <div style="font-size: 2rem; color: var(--crystal-accent); margin-bottom: 1rem;">$99</div>
              <a href="/readings" class="crystal-btn-primary">Book Now</a>
            </div>
          </div>
          
          <div class="crystal-grid-col">
            <div style="text-align: center; position: relative;">
              <div style="position: absolute; top: -10px; right: 10px; background: var(--crystal-accent); color: var(--crystal-primary); padding: 0.25rem 0.75rem; border-radius: 15px; font-size: 0.8rem; font-weight: bold;">MOST POPULAR</div>
              <h3 style="color: var(--crystal-accent); margin-bottom: 1rem;">Complete Reading</h3>
              <p style="color: var(--crystal-text-light); margin-bottom: 1.5rem;">
                90-minute comprehensive analysis with personalized action plan
              </p>
              <div style="font-size: 2rem; color: var(--crystal-accent); margin-bottom: 1rem;">$149</div>
              <a href="/readings" class="crystal-btn-primary">Book Now</a>
            </div>
          </div>
          
          <div class="crystal-grid-col">
            <div style="text-align: center;">
              <h3 style="color: var(--crystal-accent); margin-bottom: 1rem;">Premium Reading</h3>
              <p style="color: var(--crystal-text-light); margin-bottom: 1.5rem;">
                2-hour deep dive with follow-up resources and ongoing support
              </p>
              <div style="font-size: 2rem; color: var(--crystal-accent); margin-bottom: 1rem;">$249</div>
              <a href="/readings" class="crystal-btn-primary">Book Now</a>
            </div>
          </div>
        </div>
        
        <div class="crystal-center-button" style="margin-top: 2rem;">
          <a href="/readings" class="crystal-btn-primary">Learn More About Aura Sync</a>
        </div>
      </div>
    </section>
    
    <!-- Courses Section -->
    <section class="crystal-section crystal-courses">
      <div class="crystal-container">
        <h2 class="crystal-section-title crystal-gradient-text">
          Explore Our Courses
        </h2>
        <p class="crystal-text" style="text-align: center; max-width: 800px; margin: 0 auto 3rem;">
          Deepen your understanding through our comprehensive courses and educational resources. 
          From beginner-friendly introductions to advanced geometric meditation techniques, 
          find the perfect learning path for your spiritual journey.
        </p>
        
        <div class="crystal-grid">
          <div class="crystal-grid-col">
            <div style="text-align: center; padding: 2rem; background: white; border-radius: var(--crystal-border-radius); box-shadow: var(--crystal-shadow);">
              <img 
                src="/images/course-intro.jpg" 
                alt="Introduction to Sacred Geometry Course" 
                style="width: 100%; border-radius: var(--crystal-border-radius); margin-bottom: 1rem;"
              />
              <h3 style="color: var(--crystal-primary); margin-bottom: 1rem;">Introduction to Sacred Geometry</h3>
              <p style="margin-bottom: 1.5rem;">
                Perfect for beginners, this course covers the fundamental principles and basic applications.
              </p>
              <a href="/courses" class="crystal-btn-light">Learn More</a>
            </div>
          </div>
          
          <div class="crystal-grid-col">
            <div style="text-align: center; padding: 2rem; background: white; border-radius: var(--crystal-border-radius); box-shadow: var(--crystal-shadow);">
              <img 
                src="/images/course-meditation.jpg" 
                alt="Geometric Meditation Course" 
                style="width: 100%; border-radius: var(--crystal-border-radius); margin-bottom: 1rem;"
              />
              <h3 style="color: var(--crystal-primary); margin-bottom: 1rem;">Geometric Meditation</h3>
              <p style="margin-bottom: 1.5rem;">
                Learn powerful meditation techniques using sacred geometric patterns and visualizations.
              </p>
              <a href="/courses" class="crystal-btn-light">Learn More</a>
            </div>
          </div>
          
          <div class="crystal-grid-col">
            <div style="text-align: center; padding: 2rem; background: white; border-radius: var(--crystal-border-radius); box-shadow: var(--crystal-shadow);">
              <img 
                src="/images/course-applications.jpg" 
                alt="Practical Applications Course" 
                style="width: 100%; border-radius: var(--crystal-border-radius); margin-bottom: 1rem;"
              />
              <h3 style="color: var(--crystal-primary); margin-bottom: 1rem;">Practical Applications</h3>
              <p style="margin-bottom: 1.5rem;">
                Discover how to integrate sacred geometry into your daily life and spiritual practice.
              </p>
              <a href="/courses" class="crystal-btn-light">Learn More</a>
            </div>
          </div>
        </div>
        
        <div class="crystal-center-button" style="margin-top: 2rem;">
          <a href="/courses" class="crystal-btn-primary">View All Courses</a>
        </div>
      </div>
    </section>
    
    <!-- Testimonials Section -->
    <section class="crystal-section crystal-testimonials">
      <div class="crystal-container">
        <h2 class="crystal-section-title crystal-gradient-text">
          What Readers Are Saying
        </h2>
        
        <div class="crystal-grid">
          <div class="crystal-grid-col">
            <div style="text-align: center; padding: 2rem; background: var(--crystal-bg-light); border-radius: var(--crystal-border-radius); box-shadow: var(--crystal-shadow);">
              <div style="font-size: 3rem; color: var(--crystal-accent); margin-bottom: 1rem;">★★★★★</div>
              <p style="font-style: italic; margin-bottom: 1.5rem;">
                "Thoughtlyfe opened my eyes to the profound beauty and wisdom of sacred geometry. 
                Darwin's approach is both accessible and deeply transformative."
              </p>
              <div style="font-weight: bold; color: var(--crystal-primary);">- Sarah M.</div>
            </div>
          </div>
          
          <div class="crystal-grid-col">
            <div style="text-align: center; padding: 2rem; background: var(--crystal-bg-light); border-radius: var(--crystal-border-radius); box-shadow: var(--crystal-shadow);">
              <div style="font-size: 3rem; color: var(--crystal-accent); margin-bottom: 1rem;">★★★★★</div>
              <p style="font-style: italic; margin-bottom: 1.5rem;">
                "The sacred geometry reading was incredibly insightful. It provided clarity 
                on my life path that I had been seeking for years."
              </p>
              <div style="font-weight: bold; color: var(--crystal-primary);">- Michael R.</div>
            </div>
          </div>
          
          <div class="crystal-grid-col">
            <div style="text-align: center; padding: 2rem; background: var(--crystal-bg-light); border-radius: var(--crystal-border-radius); box-shadow: var(--crystal-shadow);">
              <div style="font-size: 3rem; color: var(--crystal-accent); margin-bottom: 1rem;">★★★★★</div>
              <p style="font-style: italic; margin-bottom: 1.5rem;">
                "I've found such peace through the geometric meditation techniques. 
                This book is a treasure for anyone on a spiritual journey."
              </p>
              <div style="font-weight: bold; color: var(--crystal-primary);">- Jennifer L.</div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Newsletter Section -->
    <section class="crystal-section crystal-newsletter">
      <div class="crystal-container">
        <div style="text-align: center; max-width: 600px; margin: 0 auto;">
          <h2 class="crystal-section-title crystal-light-title">
            Stay Connected
          </h2>
          <p style="color: var(--crystal-text-light); margin-bottom: 2rem; font-size: 1.2rem;">
            Join our community and receive exclusive content, meditation guides, 
            and updates on new courses and events.
          </p>
          
          <form class="crystal-newsletter-form" style="justify-content: center; max-width: 400px; margin: 0 auto;">
            <input 
              type="email" 
              class="crystal-newsletter-input" 
              placeholder="Enter your email address"
              required
            />
            <button type="submit" class="crystal-btn-primary">Subscribe</button>
          </form>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<script>
  // Newsletter form submission
  document.querySelector(".crystal-newsletter-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const email = (e.target as HTMLFormElement).querySelector("input[type='email']") as HTMLInputElement;
    if (email?.value) {
      // Here you would integrate with your newsletter service
      alert("Thank you for subscribing! We'll be in touch soon.");
      email.value = "";
    }
  });
</script>



